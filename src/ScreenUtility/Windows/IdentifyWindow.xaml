<Window x:Class="ScreenUtility.Windows.IdentifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identify display"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="#A6000000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="NumberText"
                       FontFamily="{DynamicResource DisplayFont}"
                       FontSize="132"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <TextBlock x:Name="NameText"
                       FontSize="19"
                       Foreground="#D9FFFFFF"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="560"
                       Margin="24,-8,24,0" />
            <TextBlock Text="This is display"
                       FontSize="12"
                       Foreground="#99FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</Window>
